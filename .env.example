# Copy to .env for local runs. Never commit a real salt.
# Per-team HMAC salt from the NaSCon team slip. Read only from the environment at startup.
DAY1_SALT=replace-with-the-salt-from-your-team-slip

# JWT signing secret for the API (any long random string).
JWT_SECRET=nascon26-local-jwt-secret-change-me

# MinIO (object store for PDF receipts).
MINIO_ROOT_USER=nascon-minio
MINIO_ROOT_PASSWORD=nascon-minio-secret

# Fixed inside docker-compose.yml (listed here for completeness):
# DATABASE_URL=postgresql://nascon:nascon@db:5432/nascon
# REDIS_URL=redis://redis:6379/0
# MINIO_ENDPOINT=minio:9000
